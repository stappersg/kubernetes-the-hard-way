#!/usr/bin/ansible-playbook --inventory=scripts/cluster
#
# For updating what setup-kernel.sh
#
---
- hosts: all
  gather_facts: false
  remote_user: root

  tasks:
    - name: Kernel modules that kubernetes need
      copy:
        dest: /etc/modules
        owner: root
        group: root
        mode: "0644"
        content: |
          ip_vs
          ip_vs_rr
          ip_vs_wrr
          ip_vs_sh
          br_netfilter
          nf_conntrack
      notify: Reload modules

    - name: Configure kubernetes sysctl settings
      copy:
        dest: /etc/sysctl.d/10-kubernetes.conf
        owner: root
        group: root
        mode: "0644"
        content: |
          net.ipv6.conf.all.disable_ipv6 = 1
          net.ipv6.conf.default.disable_ipv6 = 1
          net.ipv6.conf.enp5s0.disable_ipv6 = 1
          net.ipv6.conf.lo.disable_ipv6 = 1
          net.bridge.bridge-nf-call-iptables = 1
          net.ipv4.ip_forward = 1
      notify: Reload sysctl

  handlers:
    - name: Reload modules
      command: sysctl --system
      changed_when: true  # always report changed when handler runs

    - name: Reload sysctl
      command: sysctl --system
      changed_when: true
